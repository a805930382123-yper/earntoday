{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "今天又赚了多少",
  "version": "0.3.2",
  "identifier": "com.fishearn.today",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "allowDowngrades": false, "nsis": { "installMode": "currentUser" } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/a805930382123-yper/earntoday/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
